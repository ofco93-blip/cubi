<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bajar actualizaciones de GitHub -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Saber si hay internet (sin esto "Hablarle a Cubi" y "Hola Cubi" cerraban la app) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android no se lo concede a una app normal; va declarado igual que en AAAD, cuyo pedido de marca sí se respeta -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <!-- Bluetooth: Android 12 en adelante -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Bluetooth: Android 11 y anteriores (buscar dispositivos pide ubicación) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- GPS (y buscar Bluetooth en Android 11 y anteriores): llegadas y el clima del camino -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- Seguir conectado con la pantalla apagada -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Hola Cubi": el celular escucha (sin internet) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Abrir Gemini cuando Cubi lo pide, aunque la app esté en segundo plano -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android Auto: Cubi dibuja su carita, el giro y la música en la pantalla del carro -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <!-- Cubi habla: reconocimiento de voz y voz del celular -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <!-- "Cubi, pon salsa": busca y pone música en Spotify o YouTube Music -->
        <intent><action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" /></intent>
        <package android:name="com.google.android.apps.bard" />   <!-- para poder abrir la app de Gemini -->
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
    </queries>

    <application
        android:label="Cubi"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- vuelta del login de Spotify -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cubi" android:host="spotify" />
            </intent-filter>
        </activity>
        <service
            android:name=".CubiService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone|location" />
        <!-- "Cubi, pon salsa": con acceso a notificaciones le pide a Spotify que busque y reproduzca -->
        <service
            android:name=".Oyente"
            android:label="Cubi"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- presta el instalador descargado al instalador del celular -->
        <provider android:name="androidx.core.content.FileProvider" android:authorities="com.cubi.robot.archivos" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/rutas" />
        </provider>
        <!-- Android Auto. Va como app de navegación porque solo esas pueden dibujar libremente; no navega -->
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1" />
        <service android:name=".CubiCarro" android:label="Cubi" android:icon="@drawable/ic_launcher" android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>
    </application>
</manifest>
